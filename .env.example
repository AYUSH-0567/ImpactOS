# ImpactOS Enterprise Production Environment Configuration
# Copy this file to .env and configure real production secrets

# -----------------------------------------------------------------------------
# SERVER & HOSTING RUNTIME
# -----------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# -----------------------------------------------------------------------------
# DOMAIN & CORS CONFIGURATION
# -----------------------------------------------------------------------------
FRONTEND_URL="https://app.impactos.org"
BACKEND_URL="https://api.impactos.org"
VITE_API_BASE_URL="/api/v1"
CORS_ORIGIN="https://app.impactos.org,https://api.impactos.org"

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS (Generate using strong random strings)
# -----------------------------------------------------------------------------
JWT_SECRET="your_production_jwt_secret_min_64_random_chars"
SESSION_SECRET="your_production_session_cookie_secret_min_64_chars"

# -----------------------------------------------------------------------------
# PRODUCTION DATABASE (Neon PostgreSQL / Managed RDS / Supabase Postgres)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://impactos_admin:SecurePassword2026!@ep-cool-db-123456.ap-south-1.aws.neon.tech/impactos_prod?sslmode=require&pgbouncer=true"

# -----------------------------------------------------------------------------
# PRIVATE OBJECT STORAGE (Cloudflare R2 / AWS S3 / Supabase Storage)
# -----------------------------------------------------------------------------
S3_BUCKET="impactos-private-media-prod"
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="ap-south-1"
S3_ACCESS_KEY="your_s3_or_r2_access_key_id"
S3_SECRET_KEY="your_s3_or_r2_secret_access_key"

# -----------------------------------------------------------------------------
# EMAIL DISPATCH & NOTIFICATIONS (SMTP / SendGrid / Amazon SES)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="SG.your_sendgrid_or_smtp_api_key"
EMAIL_FROM_ADDRESS="notifications@impactos.org"

# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS & AI TELEMETRY
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-your_openai_api_key_if_cloud_ai_enabled"
GOOGLE_MAPS_KEY="AIzaSyYourGoogleMapsApiKeyIfCustomGIS"
VITE_DEMO_MODE=false
