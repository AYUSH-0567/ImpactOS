{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://impactos-api-production.up.railway.app/api/v1/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "framework": "vite"
    }
  }
}
