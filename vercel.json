{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://impactos-production.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/((?!assets/|favicon.svg|.*\\.(?:js|css|png|jpg|jpeg|gif|ico|svg|json|woff|woff2|ttf|eot)).*)",
      "destination": "/index.html"
    }
  ]
}
